{
    "name": "athenanetworks/abr",
    "description": "A clean, modern, object-oriented client for the Australian Business Register (ABN Lookup) web services.",
    "type": "library",
    "license": "MIT",
    "keywords": ["abr", "abn", "acn", "abn-lookup", "australian-business-register", "laravel"],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-libxml": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "*",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "*",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 HTTP client (already installed in Laravel applications)",
        "illuminate/support": "For the Laravel service provider and facade"
    },
    "autoload": {
        "psr-4": {
            "AthenaNetworks\\Abr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AthenaNetworks\\Abr\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AthenaNetworks\\Abr\\Laravel\\AbrServiceProvider"
            ],
            "aliases": {
                "Abr": "AthenaNetworks\\Abr\\Laravel\\Facades\\Abr"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "pest --exclude-group=live",
        "test:live": "pest --group=live"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
